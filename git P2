import random 

def escolher_dificuldade():
    print("\nEscolha o nível de dificuldade: ")
    print("1 -  Fácil (1 a 30 | 10 tentativas | até 10 pontos)")
    print("2 - Médio (1 a 50 | 7 tentativas | até 20 pontos)")
    print("3 - Difícil (1 a 100 | 5 tentativas | até 30 pontos)")

    while True:
        opcao = input("Digite 1, 2 ou 3:")

        if opcao == "1":
            return 30, 10, 10
        elif opcao == "2":
            return 50, 7, 20
        elif opcao == "3":
            return 100, 5, 30
        else:
            print("Opção inválida! Tente novamente.")

def jogar(pontuacao_total):

    print("=" * 40)
    print(" Jogo da Adivinhação")
    print("=" * 40)

    limite, max_tentativas, pontos_maximos = escolher_dificuldade()

    numero_secreto = random.randint(1, limite)
    tentativas = 0
    palpite = None 

    print("Estou pensando em um número entre 1 e {limite}.")
    print(f"Você tem {max_tentativas} tentativas.\n")

    while tentativas < max_tentativas:
        try:
            palpite = int(input("digite seu palpite: "))
        except ValueError:
            print("Digite apenas numeros inteiros!!\n")
            continue

        tentativas += 1

        if palpite == numero_secreto:
            pontos_ganhos = pontos_maximos - (tentativas - 1)
            if pontos_ganhos <1:
                pontos_ganhos = 1

            print(f"\n Parabéns!!! Você acertou em {tentativas} tentativa(s)!")
            print(f" você ganhou {pontos_ganhos} ponto(s)!")
            pontuacao_total += pontos_ganhos
            break

        elif palpite > numero_secreto:
            print("O numero secreto é menor.\n")
        else:
            print("O numerosegreto é maior.\n")

        print(f"Tentativas restantes: {max_tentativas - tentativas}\n")
          
    if palpite != numero_secreto:
        print(f"\n você perdeu! o numero era {numero_secreto}.")

    print(f"\n pontuação total acumulada: {pontuacao_total}")
    print("=" * 40)

    return pontuacao_total

if __name__ == "__main__":

    pontuacao_total = 0

    while True:
        pontuacao_total = jogar(pontuacao_total)
