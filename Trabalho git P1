import random 

def jogar():
    print("=" * 40)
    print(" Jogo da Adivinhação! ")
    print("=" * 40)

    numero_secreto = random.randint(1, 50)
    max_tentativas = 7
    tentativas = 0

    print("Estou pensando em um número entre 1 e 50.")
    print(f"Você tem {max_tentativas} tentativas.\n")

    while tentativas < max_tentativas:
        try:
         palpite = int(input("Digite seu palpite: "))
        except ValueError:
            print("Digite apenas números inteiros!!\n")
            continue

        tentativas += 1

        if palpite == numero_secreto:
            print(f"\n Parabéns!!! Você acertou em {tentativas} tentativa(s)!")
            break
        elif palpite > numero_secreto:
            print("O número secreto é menor.\n")
        else:
            print("O número secreto é maior.\n")

        print(f"Tentativas restantes: {max_tentativas - tentativas}\n")
          
    if palpite != numero_secreto:
        print(f"\n Você perdeu! O numero era {numero_secreto}.")

    print("\nFim do jogo!")
    print("=" * 40)

if __name__ == "__main__":
    jogar()
